{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/client" }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "^/(.*\\.(js|css|png|jpg|jpeg|svg|ico|webp|json|map))$", "dest": "/$1" },
    { "src": "^/(?!api/)(?!.*\\..*$).*$", "dest": "/index.html" }
  ]
}
